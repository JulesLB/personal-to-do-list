generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Item {
  id           Int       @id @default(autoincrement())
  title        String
  type         String    @default("task") // task | commitment | parking
  important    Boolean   @default(true)
  urgent       Boolean   @default(false)
  deadline     DateTime?
  referee      String? // wife | sister | colleague
  category     String? // personal | finance | fitness | work | business | learning
  cadence      String? // commitments only, e.g. "monthly"
  status       String    @default("open") // open | done
  snoozeUntil  DateTime?
  lastNudgedAt DateTime?
  promisedAt   DateTime? // set when you tap "I'll do it today"; evening check calls out broken promises
  doneAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Setting {
  key   String @id
  value String
}
