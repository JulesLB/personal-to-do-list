# --- Database ---
# Local dev: SQLite, zero setup. For Vercel, set the prisma provider to "postgresql"
# and use a Neon/Supabase URL, e.g. postgresql://user:pass@host/db?sslmode=require
DATABASE_URL="file:./dev.db"

# --- Claude ---
ANTHROPIC_API_KEY="sk-ant-..."

# --- Telegram ---
TELEGRAM_BOT_TOKEN="123456:ABC..."              # from @BotFather
TELEGRAM_WEBHOOK_SECRET="a-long-random-string"  # any random string you pick

# --- Board access (the key you type to open the web board) ---
APP_SECRET="another-long-random-string"

# --- Cron (set the SAME value in Vercel project settings) ---
CRON_SECRET="yet-another-random-string"

# --- Deploy URL (used by the set-webhook script) ---
APP_URL="https://your-app.vercel.app"

# --- Optional: referee WhatsApp numbers in E.164 for one-tap escalation ---
WIFE_WHATSAPP="+852..."
SISTER_WHATSAPP="+33..."
COLLEAGUE_WHATSAPP="+852..."

# --- Optional: auto-learned from your first message, set only if needed ---
OWNER_CHAT_ID=""
