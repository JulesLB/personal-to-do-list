# Keep comments on their OWN lines. node --env-file does NOT strip an inline
# "# ..." after a value; it folds the rest of the line into the value and breaks it.

# --- Database (Supabase Postgres) ---
# The Prisma provider is "postgresql". Grab both URLs from Supabase:
# Connect -> ORMs -> Prisma. Use the pooler hosts (...pooler.supabase.com),
# not the IPv6-only db.<ref>.supabase.co host.
# DATABASE_URL = transaction pooler (port 6543), used at runtime.
# DIRECT_URL   = session pooler (port 5432), used for migrations.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres"

# To develop offline instead, set provider = "sqlite" in prisma/schema.prisma and use:
# DATABASE_URL="file:./dev.db"

# --- Claude ---
ANTHROPIC_API_KEY="sk-ant-..."

# --- OpenAI (voice notes only: Whisper transcribes them before classify) ---
OPENAI_API_KEY="sk-..."

# --- Telegram ---
# Token from @BotFather. Paste it raw, no quotes-with-trailing-junk.
TELEGRAM_BOT_TOKEN="123456789:ABC..."
# Any random string you pick; must match what set-webhook sends.
TELEGRAM_WEBHOOK_SECRET="a-long-random-string"
# Optional: public t.me link to your bot. Shown on the board's first-run screen
# as an "Open Ember in Telegram" button. Unset = the onboarding step still reads,
# just without the button.
TELEGRAM_BOT_URL="https://t.me/your_bot_username"

# --- Board access (the key you type to open the web board) ---
APP_SECRET="another-long-random-string"

# --- Back-office / ops console (/admin: cost + monitoring) ---
# Separate from APP_SECRET on purpose: the board password must NOT open /admin.
# If unset, /admin can't be logged into at all (the secret is the only way in).
ADMIN_SECRET="a-different-long-random-string"

# --- Cron (set the SAME value in Vercel project settings) ---
CRON_SECRET="yet-another-random-string"

# --- Deploy URL (used by the set-webhook script) ---
APP_URL="https://your-app.vercel.app"

# --- PostHog (product analytics for the launch funnel) ---
# Client-side keys, so they're NEXT_PUBLIC_ (exposed to the browser by design).
# Unset = analytics ship dark and never initialize; set the key here + in Vercel
# to start capturing. Project API key + host from PostHog > Project Settings.
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# --- Optional: referee WhatsApp numbers in E.164 for one-tap escalation ---
WIFE_WHATSAPP="+852..."
SISTER_WHATSAPP="+33..."
COLLEAGUE_WHATSAPP="+852..."

# --- Owner name used in escalation copy ---
OWNER_NAME="Jules"

# --- WhatsApp Cloud API (M2: server-sent referee escalation) ---
# Without these three set, escalation falls back to the one-tap wa.me draft; it
# never auto-sends. From Meta for Developers > your app > WhatsApp > API Setup.
# WHATSAPP_TOKEN = a permanent system-user access token (the test token expires in 24h).
WHATSAPP_TOKEN="EAAG..."
# The sender's Phone number ID (NOT the phone number itself).
WHATSAPP_PHONE_ID="123456789012345"
# The approved template name. Register this body in Meta (category Utility):
#   Accountability alert from Ember. {{1}} committed to "{{2}}" and keeps
#   dodging it. Your job: chase them to completion. No mercy.
WHATSAPP_TEMPLATE="ember_accountability"
# Template language code; must match the approved template.
WHATSAPP_LANG="en"

# --- Optional: revoke a referee's auto-send while keeping their number ---
# Defaults to opted-in once a number is set. Set to "false" to stop auto-sends.
# WIFE_CONSENT="false"
# SISTER_CONSENT="false"
# COLLEAGUE_CONSENT="false"

# --- Owner exemption (signup is open; this is NOT a lock) ---
# The bot answers any chat (open signup). Non-owner chats are rate-limited and
# capped at MONTHLY_BUDGET_USD (~$3) of paid AI calls per HKT month; the owner is
# exempt so testing isn't throttled. Set this to your own Telegram chat id to pin
# the exemption to you. Left blank, the owner falls back to the lowest-id user
# (the first chat that ever messaged the bot).
OWNER_CHAT_ID=""
